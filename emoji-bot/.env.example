# Файл настроек. run.bat сам кладёт копию сюда: %LOCALAPPDATA%\EzzProdBot\.env (вне OneDrive).
# Токен бота = ключ подписи данных Mini App: никому не отправляй и не публикуй.
# Если токен куда-то утёк, отзови его у @BotFather командой /revoke.

# Токен бота от @BotFather (создай бота командой /newbot)
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App. Telegram не открывает http:// и localhost.
# Для разработки подними туннель (например: cloudflared tunnel --url http://localhost:8000)
# и вставь выданный адрес вида https://что-то.trycloudflare.com (без слэша на конце).
WEBAPP_URL=

# Юзернейм бота без @ (необязательно: если пусто, бот узнает его сам)
BOT_USERNAME=

# Юзернейм поддержки без @ (кнопка «поддержка» в профиле и команды /support, /paysupport)
SUPPORT_USERNAME=

# Твой Telegram ID (числа через запятую): тебе придут алерты по платежам, доступны /refund и «Админка» в Mini App.
ADMIN_IDS=

# Кастомные эмодзи Telegram в текстовых блоках Mini App: ключ:custom_emoji_id через запятую.
# Ключи и запасные обычные эмодзи — в app/emoji.py (туда же можно вписать ID). Нужен BOT_TOKEN.
# Пример: CUSTOM_EMOJI=gift:<id подарка>,warn:<id предупреждения>
CUSTOM_EMOJI=

# Название бренда: баннер, тексты, заглушки превью
BRAND_NAME=EzzProd

# Проверка интерфейса в обычном браузере без Telegram: 1 = разрешить вход без подписи Telegram.
# Работает ТОЛЬКО с этого компьютера. Вместе с публичным WEBAPP_URL приложение откажется стартовать.
# Для работы через туннель и в проде ставь 0.
DEV_MODE=0

# Этап 1: паки собираются как имитация. Когда подключим настоящую сборку, поставь 0.
DEMO_MODE=1

# Выдавать ли реальные счета в Stars. Пока паки имитируются, оставь 0.
PAYMENTS_LIVE=0

# Прокси для api.telegram.org, если напрямую недоступен (например socks5://127.0.0.1:1080)
BOT_PROXY=

# Где хранить базу и загруженные логотипы. По умолчанию на Windows: %LOCALAPPDATA%\EzzProdBot
DATA_DIR=

HOST=127.0.0.1
PORT=8000

# ── Экономика (Stars) ──
SIGNUP_GENS=1            # подарок новичку
PRICE_RUB=5              # цена одной генерации, ₽
BULK_DISCOUNT_FROM=30    # от скольки штук скидка
BULK_DISCOUNT_PCT=10     # размер скидки, %
BULK_UNIT_FROM=50        # от скольки штук фиксированная цена за штуку
BULK_UNIT_RUB=4          # цена за штуку при покупке от BULK_UNIT_FROM, ₽
RUB_PER_STAR=1.25        # курс для оплаты Звёздами: 1 звезда = столько ₽
PRO_MIN_PURCHASED=20     # сколько генераций надо купить суммарно, чтобы открылся pro
REFERRAL_REWARD=3        # награда пригласившему за первый пак друга
REFERRAL_DAILY_CAP=10    # максимум наград пригласившему в сутки
REFERRAL_LIFETIME_CAP=30 # максимум бесплатных наград пригласившему за всё время
